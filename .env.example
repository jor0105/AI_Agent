# Variable names only. Never commit real values.

# ---------------------------------------------------------------------------
# OpenAI provider
# ---------------------------------------------------------------------------
# Required when provider="openai".
OPENAI_API_KEY=your_openai_api_key_here

# Per-request timeout in seconds, passed to the OpenAI SDK. Default: 30
OPENAI_TIMEOUT=

# How many times the OpenAI SDK retries a failed request. Default: 3
OPENAI_MAX_RETRIES=

# Maximum tool-calling rounds in a single turn. Default: 100
OPENAI_MAX_TOOL_ITERATIONS=

# ---------------------------------------------------------------------------
# Ollama provider
# ---------------------------------------------------------------------------
# No API key is required; a reachable Ollama server is.
# Server address. Default: http://localhost:11434
OLLAMA_HOST=

# Attempts per call before a transport error propagates. Default: 3
OLLAMA_MAX_RETRIES=

# Maximum tool-calling rounds in a single turn. Default: 100
OLLAMA_MAX_TOOL_ITERATIONS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# The package is silent by default; these only take effect once the consumer
# calls LoggingConfig.configure().
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Default: INFO
LOG_LEVEL=

# "true" writes logs to a rotating file. Default: false
LOG_TO_FILE=

# Destination used when LOG_TO_FILE is enabled.
LOG_FILE_PATH=

# "true" emits structured JSON log records. Default: false
LOG_JSON_FORMAT=

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------
# Directory ReadLocalFileTool is confined to. Default: the process cwd
FILE_TOOL_BASE_DIR=
