# ==============================================================================
# Create Agents AI - Environment Variables Template
# Copy this file to `.env` in your project root or current working directory:
#   cp examples/.env.example .env
# ==============================================================================

# OpenAI Configuration
# Required when using provider="openai"
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_TIMEOUT=60
# OPENAI_MAX_RETRIES=3
# OPENAI_MAX_TOOL_ITERATIONS=10

# Ollama Configuration
# Used when using provider="ollama" (defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
# OLLAMA_MAX_RETRIES=3
# OLLAMA_MAX_TOOL_ITERATIONS=10

# Logging & Observability (Optional)
LOG_LEVEL=INFO
# LOG_TO_FILE=false
# LOG_FILE_PATH=logs/app.log
# LOG_JSON_FORMAT=false
